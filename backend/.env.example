PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/sugiyog_db"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Future Integration Placeholders (Not configured yet - planned for later phases)
# Email / Notification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=support@sugiyog.org

# Payment Gateway (Razorpay / Stripe)
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Cloud Media Storage (AWS S3 / Cloudinary)
STORAGE_BUCKET_NAME=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
